{
  "motion": {
    "duration": {
      "$type": "duration",
      "instant":  { "$value": "50ms" },
      "fast":     { "$value": "150ms" },
      "normal":   { "$value": "300ms" },
      "slow":     { "$value": "500ms" },
      "slower":   { "$value": "700ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "default":    { "$value": [0.2, 0, 0, 1] },
      "linear":     { "$value": [0, 0, 1, 1] },
      "in":         { "$value": [0.4, 0, 1, 1] },
      "out":        { "$value": [0, 0, 0.2, 1] },
      "in-out":     { "$value": [0.4, 0, 0.2, 1] },
      "bounce":     { "$value": [0.34, 1.56, 0.64, 1] },
      "spring":     { "$value": [0.43, 0.195, 0.02, 1.1] }
    }
  }
}
