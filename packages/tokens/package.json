{
  "name": "@myds/tokens",
  "version": "0.0.1",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./css": "./build/variables.css"
  },
  "files": [
    "dist",
    "build"
  ],
  "sideEffects": false,
  "scripts": {
    "build:tokens": "tsx sd.config.ts",
    "build:bundle": "tsup",
    "build": "npm run build:tokens && npm run build:bundle",
    "clean": "rm -rf dist build",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@myds/eslint-config": "workspace:*",
    "@myds/typescript-config": "workspace:*",
    "style-dictionary": "^4.2.0",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
